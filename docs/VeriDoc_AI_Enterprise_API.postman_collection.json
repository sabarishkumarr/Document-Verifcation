{
  "info": {
    "name": "VeriDoc AI 2.0 — Enterprise Bulk API & Verification Suite",
    "_postman_id": "veridoc-ai-2-0-enterprise-api",
    "description": "Production-ready enterprise API collection for VeriDoc AI 2.0.\n\nEnables external systems (HRMS, Loan Origination, Core Banking, Vendor Portals) to submit batches of Base64-encoded documents, track async extraction progress, execute policy-driven cross-document verification, and register HMAC-signed webhooks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:5000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "vdoc_live_test_key_sample",
      "type": "string"
    },
    {
      "key": "batch_id",
      "value": "BATCH-SAMPLE-01",
      "type": "string"
    },
    {
      "key": "applicant_id",
      "value": "APPL-SAMPLE-01",
      "type": "string"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{api_key}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Operational Readiness Probe",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/ready",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "ready"]
        },
        "description": "Public readiness probe for load balancers and upstream gateways. Validates database connectivity, OCR engine readiness, and disk storage permissions."
      },
      "response": []
    },
    {
      "name": "2. Submit Bulk Base64 Batch",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_system\": \"HRMS_PORTAL\",\n  \"external_applicant_reference\": \"EMP-2026-9812\",\n  \"external_application_reference\": \"ONBOARDING-APP-442\",\n  \"applicant_name\": \"Aditya Sharma\",\n  \"idempotency_key\": \"IDEMPOTENCY-KEY-001\",\n  \"documents\": [\n    {\n      \"external_document_reference\": \"DOC-REF-PAN-01\",\n      \"file_name\": \"aditya_pan.png\",\n      \"mime_type\": \"image/png\",\n      \"specified_document_type\": \"pan\",\n      \"content_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\"\n    },\n    {\n      \"external_document_reference\": \"DOC-REF-AADHAAR-02\",\n      \"file_name\": \"aditya_aadhaar.png\",\n      \"mime_type\": \"image/png\",\n      \"specified_document_type\": \"aadhaar\",\n      \"content_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/batches",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "batches"]
        },
        "description": "Submit a batch of Base64 documents for an external applicant. Validates magic bytes, decodes server-side, saves to secure disk storage (never logs Base64), and enqueues async background extraction."
      },
      "response": []
    },
    {
      "name": "3. Get Batch Processing Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/batches/{{batch_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "batches", "{{batch_id}}"]
        },
        "description": "Poll processing status, progress percentage, completed documents count, and verification status for a batch submission."
      },
      "response": []
    },
    {
      "name": "4. Get Batch Extraction Results",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/batches/{{batch_id}}/results",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "batches", "{{batch_id}}", "results"]
        },
        "description": "Retrieve detailed classification confidence, extracted attributes, validation results, and per-document status for all documents in the batch."
      },
      "response": []
    },
    {
      "name": "5. Trigger Batch Verification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/batches/{{batch_id}}/verification",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "batches", "{{batch_id}}", "verification"]
        },
        "description": "Trigger policy-driven cross-document verification for the applicant associated with this batch. Enforces active comparison rules, computes consistency score, and dispatches webhook."
      },
      "response": []
    },
    {
      "name": "6. Get Applicant Verification Summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/applicants/{{applicant_id}}/verification",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "applicants", "{{applicant_id}}", "verification"]
        },
        "description": "Fetch final verification report and structured comparison matrix with standardized outcomes: MATCH, MISMATCH, MISSING, NOT_COMPARABLE, REVIEW_REQUIRED, NOT_EXECUTED."
      },
      "response": []
    },
    {
      "name": "7. Register HMAC Webhook Subscription",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"target_url\": \"https://webhook.site/sample-endpoint\",\n  \"subscribed_events\": [\"batch.completed\", \"verification.completed\", \"document.reviewed\"]\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/webhooks",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "webhooks"]
        },
        "description": "Register webhook URL to receive HMAC SHA-256 signed event notifications."
      },
      "response": []
    }
  ]
}
