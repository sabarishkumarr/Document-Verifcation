# ==============================================================================
# VeriDoc AI — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values for your deployment.
# IMPORTANT: Never commit actual API keys or credentials to version control.

# Flask Environment ('development', 'testing', 'production')
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-secure-random-secret

# Server & CORS Ports
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Database Path (defaults to backend/database/veridoc.db)
# DATABASE_PATH=backend/database/veridoc.db

# Storage File Size Limit (bytes, default 16 MB)
MAX_CONTENT_LENGTH=16777216

# ==============================================================================
# AI Document Intelligence Provider Settings
# ==============================================================================
# Enable or disable AI-assisted document extraction (True / False)
AI_EXTRACTION_ENABLED=True

# Provider choice: 'gemini', 'openai', or 'mock'
AI_PROVIDER=gemini

# Google Gemini API Credentials
# Get your developer key at https://aistudio.google.com/
GEMINI_API_KEY=
# Configurable model (e.g. gemini-3.5-flash-lite, gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI API Credentials (if AI_PROVIDER=openai)
# OPENAI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini

# Request timeout in seconds
AI_TIMEOUT=30

# ==============================================================================
# Local OCR & Preprocessing Fallback Settings
# ==============================================================================
# Explicit path to Tesseract binary if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Fallback to local OCR for scanned PDFs if AI API is unavailable
PDF_OCR_FALLBACK_ENABLED=True
PDF_MIN_TEXT_CHARS=15
PDF_CHECK_IMAGE_FOR_SCAN=True
OCR_DPI=300
